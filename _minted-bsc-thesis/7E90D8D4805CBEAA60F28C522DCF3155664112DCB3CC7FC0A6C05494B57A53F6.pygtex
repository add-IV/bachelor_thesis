\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} pandaRec/search\PYGZus{}index.py}
\PYG{k}{def} \PYG{n+nf}{lemmatize\PYGZus{}no\PYGZus{}stop\PYGZus{}words}\PYG{p}{(}\PYG{n}{text}\PYG{p}{:} \PYG{n+nb}{str}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n+nb}{list}\PYG{p}{[}\PYG{n+nb}{str}\PYG{p}{]:}
	\PYG{n}{words} \PYG{o}{=} \PYG{n}{re}\PYG{o}{.}\PYG{n}{findall}\PYG{p}{(}\PYG{l+s+sa}{r}\PYG{l+s+s2}{\PYGZdq{}\PYGZbs{}w*[a\PYGZhy{}zA\PYGZhy{}Z]\PYGZbs{}w*\PYGZdq{}}\PYG{p}{,} \PYG{n}{text}\PYG{p}{)}
	\PYG{n}{wnl} \PYG{o}{=} \PYG{n}{WordNetLemmatizer}\PYG{p}{()}
