\PYG{c+c1}{\PYGZsh{} generate\PYGZus{}recipes.ipynb}

\PYG{c+c1}{\PYGZsh{} modified from https://stackoverflow.com/a/34452}
\PYG{k}{def} \PYG{n+nf}{get\PYGZus{}methods}\PYG{p}{(}\PYG{n+nb}{object}\PYG{p}{):}
	\PYG{n}{method\PYGZus{}list} \PYG{o}{=} \PYG{p}{[]}
	\PYG{k}{for} \PYG{n}{method} \PYG{o+ow}{in} \PYG{n+nb}{dir}\PYG{p}{(}\PYG{n+nb}{object}\PYG{p}{):}
		\PYG{c+c1}{\PYGZsh{} make sure its a function}
		\PYG{k}{if} \PYG{o+ow}{not} \PYG{n}{callable}\PYG{p}{(}\PYG{n+nb}{getattr}\PYG{p}{(}\PYG{n+nb}{object}\PYG{p}{,} \PYG{n}{method}\PYG{p}{)):}
			\PYG{k}{continue}
		\PYG{n}{method\PYGZus{}name} \PYG{o}{=} \PYG{n+nb}{str}\PYG{p}{(}\PYG{n}{method}\PYG{p}{)}
		
		\PYG{c+c1}{\PYGZsh{} ignore internal functions}
		\PYG{k}{if} \PYG{n}{method\PYGZus{}name}\PYG{o}{.}\PYG{n}{startswith}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}\PYGZus{}\PYGZsq{}}\PYG{p}{):}
			\PYG{k}{continue}
		
		\PYG{c+c1}{\PYGZsh{} only take functions with a docstring}
		\PYG{k}{if} \PYG{n+nb}{str}\PYG{p}{(}\PYG{n+nb}{getattr}\PYG{p}{(}\PYG{n+nb}{object}\PYG{p}{,} \PYG{n}{method}\PYG{p}{)}\PYG{o}{.}\PYG{n+nv+vm}{\PYGZus{}\PYGZus{}doc\PYGZus{}\PYGZus{}}\PYG{p}{)} \PYG{o}{==} \PYG{l+s+s1}{\PYGZsq{}None\PYGZsq{}}\PYG{p}{:}
			\PYG{k}{continue}
		\PYG{n}{method\PYGZus{}list}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}
			\PYG{p}{[}
				\PYG{n}{method\PYGZus{}name}\PYG{p}{,}
				\PYG{n+nb}{str}\PYG{p}{(}\PYG{n+nb}{getattr}\PYG{p}{(}\PYG{n+nb}{object}\PYG{p}{,} \PYG{n}{method}\PYG{p}{)}\PYG{o}{.}\PYG{n+nv+vm}{\PYGZus{}\PYGZus{}doc\PYGZus{}\PYGZus{}}\PYG{p}{)}
			\PYG{p}{]}
		\PYG{p}{)}
	\PYG{k}{return} \PYG{n}{method\PYGZus{}list}

\PYG{n}{recipes} \PYG{o}{=} \PYG{p}{[}
