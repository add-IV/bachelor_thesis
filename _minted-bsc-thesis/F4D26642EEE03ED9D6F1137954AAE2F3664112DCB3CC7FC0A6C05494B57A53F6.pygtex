\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} pandaRec/search\PYGZus{}index.py}
\PYG{k}{def} \PYG{n+nf}{generate\PYGZus{}search\PYGZus{}index}\PYG{p}{(}\PYG{n}{descriptions}\PYG{p}{:} \PYG{n+nb}{list}\PYG{p}{[}\PYG{n+nb}{str}\PYG{p}{])}
		\PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n+nb}{dict}\PYG{p}{[}\PYG{n+nb}{str}\PYG{p}{,} \PYG{n+nb}{list}\PYG{p}{[}\PYG{n+nb}{tuple}\PYG{p}{[}\PYG{n+nb}{int}\PYG{p}{,} \PYG{n+nb}{int}\PYG{p}{]]]:}
	\PYG{c+c1}{\PYGZsh{} 1. Lemmatize the descriptions}
	\PYG{n}{lemmatized\PYGZus{}descriptions} \PYG{o}{=} \PYG{p}{[}
			\PYG{n}{lemmatize\PYGZus{}no\PYGZus{}stop\PYGZus{}words}\PYG{p}{(}\PYG{n}{description}\PYG{p}{)} \PYG{k}{for} \PYG{n}{description} \PYG{o+ow}{in} \PYG{n}{descriptions}
		\PYG{p}{]}
	\PYG{c+c1}{\PYGZsh{} 2. build the forward index, one list of (word, frequenzy) tuples}
	\PYG{c+c1}{\PYGZsh{} per description}
	\PYG{n}{frequency\PYGZus{}per\PYGZus{}description} \PYG{o}{=} \PYG{p}{[}
			\PYG{p}{[(}\PYG{n}{word}\PYG{p}{,} \PYG{n}{description}\PYG{o}{.}\PYG{n}{count}\PYG{p}{(}\PYG{n}{word}\PYG{p}{))} \PYG{k}{for} \PYG{n}{word} \PYG{o+ow}{in} \PYG{n+nb}{set}\PYG{p}{(}\PYG{n}{description}\PYG{p}{)]}
			\PYG{k}{for} \PYG{n}{description} \PYG{o+ow}{in} \PYG{n}{lemmatized\PYGZus{}descriptions}
		\PYG{p}{]}
	\PYG{c+c1}{\PYGZsh{} 3. construct the inverted index as hashmap with list of}
	\PYG{c+c1}{\PYGZsh{} (description\PYGZus{}index, frequency) tuples for each word}
	\PYG{n}{frequency\PYGZus{}per\PYGZus{}word} \PYG{o}{=} \PYG{p}{\PYGZob{}\PYGZcb{}}
	\PYG{k}{for} \PYG{n}{idx}\PYG{p}{,} \PYG{n}{description} \PYG{o+ow}{in} \PYG{n+nb}{enumerate}\PYG{p}{(}\PYG{n}{frequency\PYGZus{}per\PYGZus{}description}\PYG{p}{):}
		\PYG{k}{for} \PYG{p}{(}\PYG{n}{word}\PYG{p}{,} \PYG{n}{count}\PYG{p}{)} \PYG{o+ow}{in} \PYG{n}{description}\PYG{p}{:}
			\PYG{k}{if} \PYG{n}{word} \PYG{o+ow}{not} \PYG{o+ow}{in} \PYG{n}{frequency\PYGZus{}per\PYGZus{}word}\PYG{p}{:}
				\PYG{n}{frequency\PYGZus{}per\PYGZus{}word}\PYG{p}{[}\PYG{n}{word}\PYG{p}{]} \PYG{o}{=} \PYG{p}{[(}\PYG{n}{idx}\PYG{p}{,} \PYG{n}{count}\PYG{p}{)]}
			\PYG{k}{else}\PYG{p}{:}
				\PYG{n}{frequency\PYGZus{}per\PYGZus{}word}\PYG{p}{[}\PYG{n}{word}\PYG{p}{]}\PYG{o}{.}\PYG{n}{append}\PYG{p}{((}\PYG{n}{idx}\PYG{p}{,} \PYG{n}{count}\PYG{p}{))}
	\PYG{k}{return} \PYG{n}{frequency\PYGZus{}per\PYGZus{}word}
\end{Verbatim}
