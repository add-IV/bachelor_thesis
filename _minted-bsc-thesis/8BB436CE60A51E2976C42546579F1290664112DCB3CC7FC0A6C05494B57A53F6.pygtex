		\PYG{n}{scores} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{recipes}\PYG{p}{)} \PYG{o}{*} \PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}
