\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} pandaRec/strategies.py}
\PYG{k}{class} \PYG{n+nc}{IndexSearch}\PYG{p}{(}\PYG{n}{RankingStrategy}\PYG{p}{):}
