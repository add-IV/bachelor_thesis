		\PYG{n}{lemmatized\PYGZus{}search} \PYG{o}{=} \PYG{n}{lemmatize\PYGZus{}no\PYGZus{}stop\PYGZus{}words}\PYG{p}{(}\PYG{n}{context}\PYG{o}{.}\PYG{n}{query}\PYG{p}{)}
		
